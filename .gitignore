# Repository-local Dreamcast build products and generated artifacts.
/.dreamcast/
/build/
*.elf
*.map
*.o
*.d
tests/native/*.bin
tests/native/*.out

# .NET build outputs. The builder and its tests should use --artifacts-path
# under .dreamcast; a bare `dotnet build`/`dotnet test` still drops these here.
bin/
obj/

# Emulator logs, local tooling caches, and accidental shell outputs.
*.log
/.claude/
/.local/
/.superpowers/
/Draw
/Update
